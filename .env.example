# Safe service bind default. Keep this value when the application runs on the Docker host.
AGENT_DOCKER_BIND_HOST=127.0.0.1

# LAN Docker host example (also update the application addresses below):
# AGENT_DOCKER_BIND_HOST=192.168.1.200
# AGENT_DB_URL=jdbc:mysql://192.168.1.200:3307/smart_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# AGENT_REDIS_HOST=192.168.1.200
# AGENT_QDRANT_HOST=192.168.1.200

# Container service settings
MYSQL_ROOT_PASSWORD=smart_agent_root_dev
MYSQL_DATABASE=smart_agent
MYSQL_USER=smart_agent
MYSQL_PASSWORD=smart_agent_dev

# Application service addresses
AGENT_DB_URL=jdbc:mysql://localhost:3307/smart_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
AGENT_DB_USERNAME=smart_agent
AGENT_DB_PASSWORD=smart_agent_dev
AGENT_REDIS_HOST=localhost
AGENT_REDIS_PORT=6380
AGENT_QDRANT_HOST=localhost
AGENT_QDRANT_GRPC_PORT=6334
AGENT_QDRANT_API_KEY=
AGENT_QDRANT_ENABLED=false
AGENT_QDRANT_TLS=false
AGENT_QDRANT_COLLECTION=agent_knowledge_dev
AGENT_QDRANT_VECTOR_DIMENSION=64
AGENT_EMBEDDING_MODE=local-hash
AGENT_MODEL_MODE=local
AGENT_MODEL_BASE_URL=http://localhost:11434/v1
AGENT_MODEL_API_KEY=local-development-key
AGENT_CHAT_MODEL=local-test-model
# Development-only placeholder. Generate a random value locally; production must use a secret manager.
AGENT_LOCAL_CONTEXT_SECRET=change-this-local-context-secret-before-sharing
